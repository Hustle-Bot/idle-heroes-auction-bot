<?xml version="1.0" encoding="utf-8"?>
<!-- This app ("oss"): no internet, no self-update, no screen recording. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app itself never goes online. Libraries (Google ML Kit's usage logging) would add INTERNET – removed here.
         The text recognition (only if the player turns it on) runs through Google Play services, which download the
         model themselves. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application>
        <!-- Review round 3 (Nov 23): Google ML Kit's start-up provider. A library merges it into the app, and Android
             starts every provider at each start of the app - so ML Kit was set up (and could log its use) even with the
             setting "Google text recognition" off. Removed here; MlKitLeser sets ML Kit up itself (MlKit.initialize),
             only when the setting is on. The CI step "Components of the debug APK" prints what is left. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />

        <!-- Sharing a report: read-only access for the app the player picks, only to the one ZIP file in
             cache/geteilt/ (res/xml/berichte_teilen.xml). Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.berichte"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/berichte_teilen" />
        </provider>
    </application>
</manifest>
