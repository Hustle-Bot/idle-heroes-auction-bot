<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shared part. This manifest has no permissions: the player turns the accessibility service on in
         Android's settings. -->

    <!-- START in the app opens Idle Heroes (Google Play): Android 11+ only shows an app to another app if it is named
         here. Only this one app, no permission. -->
    <queries>
        <package android:name="com.droidhang.ad" />
    </queries>

    <!-- Settings are backed up (they survive a reinstall); the secrets (secondary password), the consent and the run
         state are not (res/xml/sicherung*.xml). -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/sicherung"
        android:fullBackupContent="@xml/sicherung_alt"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="${appLabel}"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Review round 2 (Nov 23): no install-time download of Google's text recognition here. It is only used if the
             setting "Google text recognition" is on; then Google Play services fetch it on first use. -->

        <!-- Settings: how-to, rules, goal, time, reports, log. The only activity other apps can start
             (launcher). -->
        <activity
            android:name=".EinstellungenActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The accessibility service: takes screenshots, taps, shows the floating button, locks the screen at the end.
             Exported as Android requires, but only the system may bind to it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".BotDienst"
            android:exported="true"
            android:label="${appLabel}"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bedienungshilfe" />
        </service>
    </application>
</manifest>
